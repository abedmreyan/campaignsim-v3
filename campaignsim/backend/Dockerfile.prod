FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

WORKDIR /app/backend
COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev

COPY backend/ .
COPY locales/ /app/locales
COPY .env.production /app/.env

EXPOSE 8080
# Single worker process, not multiple: TaskManager (app/models/task.py) and
# SimulationRunner (app/services/simulation_runner.py) both hold live state
# (task registries, subprocess.Popen handles, monitor threads) in plain
# in-process dicts, not a DB/Redis — a request handled by one worker can't
# see state created in another. Matches the original app.run(threaded=True)
# concurrency model: one process, many threads.
CMD ["uv", "run", "gunicorn", "--workers", "1", "--threads", "8", \
     "--worker-class", "gthread", "--timeout", "120", \
     "--bind", "0.0.0.0:8080", "app:create_app()"]
