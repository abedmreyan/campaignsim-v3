# CampaignSim frontend environment (copy to `.env` or `.env.local`)

# Base URL for the Flask/backend API when VITE_USE_MOCKS=false
VITE_API_BASE_URL=http://localhost:5001

# Mock mode is opt-in: only the exact string "true" enables the in-browser
# mock API. Any other value (or leaving this unset) uses the real backend.
VITE_USE_MOCKS=false
